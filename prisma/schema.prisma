// 数据模型：对应 PRD 第三层"数据对象描述"，所有业务对象以 shopId 为隔离键，没有用户对象；Agent 技能的内容存于 skills/ 目录的 .md 文件，其启用状态存于 Skill 表。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 店铺：系统的隔离单元，所有业务数据都归属某个店铺。
model Shop {
  id          String   @id @default(cuid())
  name        String
  market      String // 目标市场，如"美国"、"东南亚-印尼"
  description String? // 店铺简述
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products      Product[]
  productCopies ProductCopy[]
  videoScripts  VideoScript[]
  liveScripts   LiveScript[]
  conversations Conversation[]
  memories      MemoryEntry[]
  generations   Generation[]
  productDnas        ProductDna[]
  contentReferences  ContentReference[]
  publishedVideos    PublishedVideo[]
  videoReviews       VideoReview[]
  shotRequirements   ShotRequirement[]
}

// 商品：属于某个店铺，支持变体。
model Product {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  category    String? // 类目
  price       Float? // 基础价格
  description String? // 商品描述
  skuRule     String? // Agent 建议的 SKU 编码规则，如 "MZ-{颜色}-{尺寸}"
  testingStatus String? // 测品状态：null=普通在售; "testing"=测品中; "scaled"=已放量; "killed"=已淘汰
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  copies    ProductCopy[]
  variants  ProductVariant[]
  images    ProductImage[]
  videoScripts VideoScript[]
  // 内容运营反向关联：只是声明，不增加数据库列；商品删除时级联删除下列数据。
  dna               ProductDna?
  contentReferences ContentReference[]
  publishedVideos   PublishedVideo[]
  shotRequirements  ShotRequirement[]
}

// 商品变体：颜色、尺寸等组合，每个变体有 SKU 编码。
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String
  color     String?
  size      String?
  price     Float? // 变体价格，缺省时用商品基础价格
  stock     Int? // 库存数量
  createdAt DateTime @default(now())

  @@unique([productId, sku]) // 同一商品内 SKU 唯一，防止重复建档导致无法区分
}

// 商品图片：图片文件本体存在 public/generated/ 目录，这里记录图片的路径、用途和应用状态。
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String // 图片文件在磁盘上的相对路径，如 /generated/abc123.png
  type      String // 用途："main"（主图）/ "detail"（详情图）/ "variant"（变体）
  prompt    String? // 生成这张图时使用的提示词
  applied   Boolean  @default(false) // 是否已应用到商品（false 草稿 / true 已应用）
  sortOrder Int      @default(0) // 详情图序列中的显示顺序
  createdAt DateTime @default(now())
}

// 文案版本：一次 AI 生成或一次人工修改产生一个版本。
model ProductCopy {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId        String // 隔离键（PRD：所有业务对象以 shopId 为隔离键）
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title         String
  description   String
  sellingPoints String?
  language      String // 目标市场语言，如 "en"、"id"
  version       Int // 版本号，同一商品递增
  source        String // 来源："ai" 或 "human"
  isCurrent     Boolean  @default(false) // 是否为商品当前应用的版本
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt // 修改时间（切换当前版本时更新）

  @@unique([productId, version]) // 同一商品内版本号唯一，防止并发生成重复版本
}

// 视频脚本：分镜内容、钩子、CTA；shots 存 JSON 文本（SQLite 不支持 Json 类型）。
// version 与 parentScriptId 支持 V1 → V2 迭代：V2 脚本指向它基于的上一版。
model VideoScript {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String? // 可关联某个商品；商品删除时级联清理关联脚本，避免内容孤岛。
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // 开箱 / 教程 / 种草 / 对比
  duration  Int // 时长（秒）
  hook      String // 前 3 秒钩子文案
  cta       String // 结尾行动号召
  style     String? // 模仿的参考风格描述
  shots     String // 分镜内容，JSON 文本
  version        Int     @default(1) // 版本号，首发为 1，复盘后的 V2 为 2
  parentScriptId String? // 上一版脚本 ID（V2 指向 V1）；上一版删除时置空
  parentScript   VideoScript?  @relation("ScriptVersions", fields: [parentScriptId], references: [id], onDelete: SetNull)
  childScripts   VideoScript[] @relation("ScriptVersions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedVideos PublishedVideo[] @relation("VideoScriptPublished")
  reviewGenerated VideoReview[]   @relation("ReviewGeneratedScript")
}

// 直播脚本：时长、商品列表、流程节点。
model LiveScript {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  duration    Int // 时长（秒）
  productList String // 商品列表
  flow        String // 流程节点：开场、讲解顺序、互动、促销节奏
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 对话：属于某个店铺的一次连续对话。
model Conversation {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 消息：属于某个对话，角色为用户或 Agent。
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" 或 "agent"
  content        String
  toolCalls      String? // 工具调用过程，JSON 文本
  createdAt      DateTime     @default(now())
}

// 记忆条目：店铺画像与用户偏好，分类存储，可编辑删除。
model MemoryEntry {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category  String // 如"店铺定位"、"内容偏好"
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, category, content]) // 同店同分类同内容只存一条：并发提取时由数据库兜底去重
}

// 生成审计：每次 AI 调用留一条记录。
model Generation {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type      String // 如"copywriting"、"script"、"image"、"chat"
  model     String
  prompt    String?
  output    String?
  status    String // "success" / "error"
  error     String? // 失败时的错误信息
  createdAt DateTime @default(now())
}

// 技能：模板内容存于 skills/ 目录的 .md 文件，这里记录技能的启用状态与管理信息；不属于特定店铺。
model Skill {
  id          String   @id @default(cuid())
  name        String // 技能名称
  filename    String // skills/ 目录下的文件名，如 "示例-美式口语化文案.md"
  description String? // 技能说明
  enabled     Boolean  @default(true) // 是否启用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 商品 DNA：一个商品只有一份当前 DNA，结构化沉淀画像、场景、卖点等生成内容的共同底座；productId 唯一实现一对一。
model ProductDna {
  id                    String   @id @default(cuid())
  shopId                String // 隔离键
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPersona         String // 核心用户画像
  useScenarios          String // 核心使用场景
  coreSellingPoints     String // 核心卖点
  visualHooks           String // 视觉冲击效果
  recommendedFormats    String // 推荐视频呈现方式
  competitorDifferences String // 竞品差异
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// 爆款内容拆解：采集的同行爆款视频的结构化拆解，作为选题与脚本的参照。
model ContentReference {
  id                    String   @id @default(cuid())
  shopId                String // 隔离键
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceVideoId         String? // 外部视频编号
  sourceUrl             String? // 外部视频地址
  title                 String // 标题
  angle                 String // 内容类型：开箱 / 教程 / 种草 / 对比
  playCount             Int // 播放量
  conversionRate        Float? // 转化率（百分比）
  completionRate        Float? // 完播率（百分比）
  hook                  String // 开头钩子
  sellingPoint          String? // 核心卖点
  highFrequencyQuestion String? // 高频问题
  cta                   String // 行动号召
  collectedAt           DateTime // 采集时间
  createdAt             DateTime @default(now())
}

// 已发布视频：卖家自己发布视频的投放数据；retentionData 存秒级留存数组（JSON 文本，SQLite 不支持 Json 类型）。
model PublishedVideo {
  id              String    @id @default(cuid())
  shopId          String // 隔离键
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  scriptId        String? // 对应的视频脚本；脚本删除时置空保留视频数据
  script          VideoScript? @relation("VideoScriptPublished", fields: [scriptId], references: [id], onDelete: SetNull)
  platformVideoId String? // 平台视频编号
  title           String // 视频标题或 Hook
  angle           String // 视频类型：开箱 / 教程 / 种草 / 对比
  durationSeconds Int // 视频时长（秒）
  playCount       Int // 播放量
  orderCount      Int // 订单量
  gmv             Float // 成交金额
  completionRate  Float? // 完播率（百分比）
  status          String // 在跑 / 停止
  retentionData   String // 秒级留存数组，JSON 文本，如 [100,86,74,...]
  publishedAt     DateTime? // 发布时间
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  review VideoReview?
}

// 视频复盘：一条已发布视频对应一份复盘；publishedVideoId 唯一实现一对一，视频删除时级联删除。
// suggestions 存建议列表（JSON 文本）。
model VideoReview {
  id                 String         @id @default(cuid())
  shopId             String // 隔离键
  shop               Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  publishedVideoId   String         @unique
  publishedVideo     PublishedVideo @relation(fields: [publishedVideoId], references: [id], onDelete: Cascade)
  dropPointSeconds   Float? // 主要流失秒数
  dropRate           Float? // 流失比例（百分比）
  summary            String // 问题总结
  suggestions        String // 建议列表，JSON 文本
  generatedScriptId  String? // 复盘后生成的 V2 脚本；脚本删除时置空
  generatedScript    VideoScript?   @relation("ReviewGeneratedScript", fields: [generatedScriptId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// 素材需求：按镜头拆出的拍摄任务；scriptIds 存共用该镜头的脚本 ID（JSON 数组文本），不建关联表。
// shopId + productId + shotCode 唯一：同一商品内镜头编号稳定，重复同步（并发/重试）只插入一次的兜底。
model ShotRequirement {
  id                String   @id @default(cuid())
  shopId            String // 隔离键
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shotCode          String // 镜头编号，如 S01
  scene             String // 拍摄场景
  actionDescription String // 景别与动作
  propsAndLighting  String // 道具与打光
  scriptIds         String // 共用脚本 ID，JSON 数组文本
  status            String // 待拍摄 / 拍摄中 / 已完成 / 已归档
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shopId, productId, shotCode])
}
