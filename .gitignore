# 依赖目录
node_modules/

# 构建产物
.next/
out/
*.tsbuildinfo
next-env.d.ts

# 环境变量（包含密钥，绝不提交）
.env
.env.local
.env.*.local

# 数据工具（SQLite 数据库、密钥配置文件、生成的图片）
data/*
!data/.gitkeep
public/generated/*
!public/generated/.gitkeep

# 测试临时数据库（content-cascade / product-dna / 建库产物，崩溃残留兜底）
prisma/*test*.db*
prisma/*verify*.db*
prisma/*.db*

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/

# 启动日志
logs/

# 本地读码索引（cleanread 工具产物）
cleanread/

# 测试临时数据库（content-cascade / product-dna 测试用，崩溃残留兜底）
prisma/*test*.db*
