# ================= 对话与推理模型（Agent 主模型） =================
# 对话、文案、脚本、记忆提取共用：deepseek 等 OpenAI 兼容模型
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
MEMORY_MODEL=deepseek-chat

# ================= 上下文管理（保守估计，不是精确分词） =================
# 已注册模型优先使用SDK容量元数据；未知模型才用fallback，须按供应商实际容量填写。
# 默认64k是未知自定义模型的显式fallback，不是供应商容量保证；小容量模型请下调并精简工具/常驻技能。
CONTEXT_FALLBACK_CAPACITY=65536
CONTEXT_FALLBACK_MAX_TOKENS=4096
# 从真实模型contextWindow预留输出、安全和后续工具空间；输出不超过模型maxTokens。
CONTEXT_OUTPUT_TOKENS=4096
CONTEXT_SAFETY_TOKENS=2048
CONTEXT_TOOL_RESERVE_TOKENS=4096
# 持久结构化摘要最大估计token数；原文始终保存在数据库，可用历史回查工具分页读取。
CONTEXT_SUMMARY_TOKENS=2048

# ================= 图片生成模型 =================
# 商品主图 / 详情图 / 变体生成：gpt-image-2，需要单独的 OpenAI Key
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2

# ================= FastMoss 数据 MCP =================
# 选品、市场、竞品数据来源，Key 和接口地址以 FastMoss 开放平台文档为准
FASTMOSS_API_KEY=
FASTMOSS_BASE_URL=

# ================= 数据库 =================
# SQLite 本地文件，路径相对于 prisma/ 目录
DATABASE_URL="file:../data/kuajing.db"

# 说明：以上变量可在首次引导页填写（会保存到服务端本地配置文件 data/config.json，
# 优先级高于 .env），也可以直接复制本文件为 .env 手动填写。
